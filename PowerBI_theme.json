{
  "name": "SegmentIQ Dark Hierarchy",
  "dataColors": [
    "#6366F1",
    "#06B6D4",
    "#F59E0B",
    "#EF4444",
    "#10B981",
    "#818CF8",
    "#38BDF8",
    "#FBBF24"
  ],
  "background": "#0B1326",
  "foreground": "#F8FAFC",
  "tableAccent": "#6366F1",
  "good": "#10B981",
  "neutral": "#64748B",
  "bad": "#EF4444",
  "maximum": "#6366F1",
  "center": "#0B1326",
  "minimum": "#1E293B",
  "null": "#334155",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 28,
      "color": "#F8FAFC"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#F8FAFC"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#F8FAFC"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{
          "show": true,
          "color": { "solid": { "color": "#0B1326" } },
          "transparency": 0
        }],
        "visualHeader": [{
          "show": true,
          "foreground": { "solid": { "color": "#F8FAFC" } },
          "background": { "solid": { "color": "#0B1326" } }
        }],
        "border": [{
          "show": true,
          "color": { "solid": { "color": "#1E293B" } },
          "radius": 6
        }],
        "dropShadow": [{
          "show": false,
          "color": { "solid": { "color": "#000000" } },
          "position": "Outer",
          "preset": "BottomRight"
        }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#F8FAFC" } },
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "Left"
        }]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 9,
          "fontFamily": "Segoe UI"
        }],
        "valueAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 9,
          "fontFamily": "Segoe UI"
        }],
        "labels": [{
          "show": true,
          "color": { "solid": { "color": "#F8FAFC" } },
          "fontSize": 9
        }]
      }
    },
    "clusteredBarChart": { "*": { "labels": [{ "show": true }] } },
    "stackedBarChart": { "*": { "labels": [{ "show": true }] } },
    "columnChart": {
      "*": {
        "categoryAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 9
        }],
        "valueAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 9
        }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#F8FAFC" } } }]
      }
    },
    "clusteredColumnChart": { "*": { "labels": [{ "show": true }] } },
    "stackedColumnChart": { "*": { "labels": [{ "show": true }] } },
    "lineChart": {
      "*": {
        "lineStyles": [{
          "strokeWidth": 3,
          "strokeLineCap": "round"
        }],
        "categoryAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 9
        }],
        "valueAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 9
        }],
        "markers": [{ "show": true, "size": 5 }]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2 }],
        "categoryAxis": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#94A3B8" } } }],
        "valueAxis": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#94A3B8" } } }]
      }
    },
    "pieChart": {
      "*": {
        "legend": [{
          "show": true,
          "position": "Right",
          "fontSize": 9,
          "labelColor": { "solid": { "color": "#F8FAFC" } }
        }],
        "labels": [{
          "show": true,
          "color": { "solid": { "color": "#F8FAFC" } },
          "labelStyle": "Category, percent of total"
        }]
      }
    },
    "donutChart": {
      "*": {
        "legend": [{ "show": true, "position": "Right", "labelColor": { "solid": { "color": "#F8FAFC" } } }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#F8FAFC" } } }]
      }
    },
    "scatterChart": {
      "*": {
        "categoryAxis": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#94A3B8" } } }],
        "valueAxis": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#94A3B8" } } }],
        "markers": [{ "size": 8 }]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [{
          "increase": { "solid": { "color": "#10B981" } },
          "decrease": { "solid": { "color": "#EF4444" } },
          "total": { "solid": { "color": "#6366F1" } }
        }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#F8FAFC" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridVertical": true,
          "gridVerticalColor": { "solid": { "color": "#1E293B" } },
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#1E293B" } },
          "textSize": 9
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#6366F1" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#F8FAFC" } },
          "backColorPrimary": { "solid": { "color": "#0B1326" } },
          "fontColorSecondary": { "solid": { "color": "#F8FAFC" } },
          "backColorSecondary": { "solid": { "color": "#131C31" } }
        }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "textSize": 9, "gridHorizontalColor": { "solid": { "color": "#1E293B" } } }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#6366F1" } },
          "fontSize": 10
        }],
        "rowHeaders": [{
          "fontColor": { "solid": { "color": "#F8FAFC" } },
          "backColor": { "solid": { "color": "#0B1326" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#F8FAFC" } },
          "backColorPrimary": { "solid": { "color": "#0B1326" } },
          "fontColorSecondary": { "solid": { "color": "#F8FAFC" } },
          "backColorSecondary": { "solid": { "color": "#131C31" } }
        }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "color": { "solid": { "color": "#F8FAFC" } },
          "fontSize": 28,
          "fontFamily": "Segoe UI Bold"
        }],
        "categoryLabels": [{
          "show": true,
          "color": { "solid": { "color": "#94A3B8" } },
          "fontSize": 10
        }]
      }
    },
    "cardVisual": {
      "*": {
        "calloutValues": [{
          "color": { "solid": { "color": "#F8FAFC" } },
          "fontSize": 28,
          "fontFamily": "Segoe UI Bold"
        }],
        "cardLabels": [{
          "color": { "solid": { "color": "#94A3B8" } },
          "fontSize": 10
        }]
      }
    },
    "slicer": {
      "*": {
        "header": [{
          "show": true,
          "fontColor": { "solid": { "color": "#F8FAFC" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold"
        }],
        "items": [{
          "fontColor": { "solid": { "color": "#F8FAFC" } },
          "background": { "solid": { "color": "#0B1326" } },
          "fontSize": 9
        }]
      }
    },
    "map": {
      "*": {
        "bubbles": [{ "show": true, "maxSize": 20 }]
      }
    },
    "filledMap": {
      "*": {
        "legend": [{ "show": true, "labelColor": { "solid": { "color": "#F8FAFC" } } }]
      }
    }
  }
}